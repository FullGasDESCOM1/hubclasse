 "faq": [
  {
   "q": "Quante assenze si possono fare?",
   "a": "La frequenza è obbligatoria per l'80% delle ore di ogni insegnamento. Oltre la soglia, per gravi motivi, si presenta il modulo in segreteria didattica e decide il Coordinatore Accademico.",
   "src": "Regolamento didattico, art. 5.7 e 5.8"
  },
  {
   "q": "Quando si supera un esame?",
   "a": "Con almeno 18/30 o un'idoneità. Se sei assente per un motivo grave, serve una domanda scritta con documenti entro 7 giorni di calendario dall'esame.",
   "src": "Regolamento didattico, art. 18.12 e 18.9"
  },
  {
   "q": "Quanti crediti servono per il secondo anno?",
   "a": "40 crediti.",
   "src": "Regolamento didattico, art. 22.1"
  },
  {
   "q": "Come si chiede un certificato?",
   "a": "Iscrizione e frequenza si chiedono alla segreteria. Le autocertificazioni si stampano da IED Campus, area Segreteria.",
   "src": "Regolamento didattico, art. 3.1 e 3.2"
  },
  {
   "q": "Dove arrivano le comunicazioni ufficiali?",
   "a": "Sulla casella email istituzionale, da controllare regolarmente.",
   "src": "Regolamento generale, art. 21.1"
  }
 ],
